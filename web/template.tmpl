                radial-gradient(ellipse 85% 50% at 50% -8%,
                                rgba(150, 245, 255, .20) 0%, transparent 65%),
                /* reflejo sobre la superficie del agua */
                radial-gradient(ellipse 65% 28% at 50% 84%,
                                rgba(105, 225, 245, .16) 0%, transparent 70%),
                /* mar */
                linear-gradient(180deg,
                                #021620 0%,
                                #05303f 24%,
                                #0a5468 46%,
                                #0b6b7d 60%,
                                #075263 74%,
                                #032430 100%);
            transition: opacity .45s ease;
        }

        #splash.oculto {
            opacity: 0;
            pointer-events: none;
        }

        /* Las capas decorativas van en z-index -1: quedan por encima del
           fondo de #splash pero por debajo del titulo y el barco. */

        /* rayos de luz filtrandose en diagonal */
        #splash::before {
            content: "";
            position: absolute;
            inset: -20% -30% 35% -30%;
            z-index: -1;
            pointer-events: none;
            background: repeating-linear-gradient(
                104deg,
                transparent 0 42px,
                rgba(160, 250, 255, .05) 42px 78px,
                transparent 78px 150px
            );
            animation: mininaval-rayos 14s ease-in-out infinite alternate;
        }

        @keyframes mininaval-rayos {
            from { transform: translateX(-40px); opacity: .55; }
            to   { transform: translateX(40px);  opacity: 1; }
        }

        #splash-mar {
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            height: 24%;
            z-index: -1;
            pointer-events: none;
        }

        #splash-mar i {
            position: absolute;
            left: 0;
            right: 0;
            bottom: -10px;
            height: 100%;
            background-repeat: repeat-x;
            background-position: 0 bottom;
            image-rendering: pixelated;
        }

        #splash-mar .lejos {
            background-size: 32.0vh 11vh;
            background-image: url(data:image/svg+xml;base64,);
            animation: mininaval-corriente-lejos 23s linear infinite,
                       mininaval-vaiven 7s ease-in-out infinite;
        }

        #splash-mar .medio {
            background-size: 36.0vh 15vh;
            background-image: url(data:image/svg+xml;base64,);
            animation: mininaval-corriente-medio 15s linear infinite,
                       mininaval-vaiven 5.5s ease-in-out infinite reverse;
        }

        #splash-mar .cerca {
            background-size: 40.0vh 20vh;
            background-image: url(data:image/svg+xml;base64,);
            animation: mininaval-corriente-cerca 9s linear infinite,
                       mininaval-vaiven 4s ease-in-out infinite;
        }

        @keyframes mininaval-corriente-lejos {
            from { background-position-x: 0; }
            to   { background-position-x: -64.0vh; }
        }

        @keyframes mininaval-corriente-medio {
            from { background-position-x: 0; }
            to   { background-position-x: 72.0vh; }
        }

        @keyframes mininaval-corriente-cerca {
            from { background-position-x: 0; }
            to   { background-position-x: -80.0vh; }
        }

        @keyframes mininaval-vaiven {
            0%, 100% { transform: translateY(0); }
            50%      { transform: translateY(-5px); }
        }

        /* oleaje: bandas horizontales que suben despacio */
        #splash::after {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            height: 55%;
            pointer-events: none;
            background: repeating-linear-gradient(
                180deg,
                rgba(255, 255, 255, .045) 0 3px,
