    <script type="application/javascript">
    // Controla el splash de carga. La runtime de pygbag se comunica
    // escribiendo texto en #infobox y, cuando el juego ya arranco, lo
    // esconde con display:none. Eso es lo que se observa aca.
    (function () {
        const splash = document.getElementById("splash");
        const infobox = document.getElementById("infobox");
        if (!splash || !infobox) return;

        const TRADUCCIONES = [
            [/^Ready to start.*/i, "Hace click para empezar"],
            [/^installing (.*)/i, "instalando $1"],
            [/^Loading.*/i, "Cargando..."],
            [/^Downloading.*/i, "Descargando..."],
        ];

        let escribiendo = false;

        function traducir() {
            if (escribiendo) return;
            const texto = infobox.innerText.trim();
            for (const [patron, es] of TRADUCCIONES) {
                if (!patron.test(texto)) continue;
                const nuevo = texto.replace(patron, es);
                if (nuevo !== texto) {
                    escribiendo = true;
                    infobox.innerText = nuevo;
                    escribiendo = false;
                }
                return;
            }
        }

        function cerrar() {
            if (splash.classList.contains("oculto")) return;
            splash.classList.add("oculto");
            setTimeout(function () { splash.remove(); }, 500);
        }

        new MutationObserver(function () {
            if (infobox.style.display === "none") cerrar();
            else traducir();
        }).observe(infobox, {
            attributes: true,
            attributeFilter: ["style"],
            childList: true,
            characterData: true,
            subtree: true,
        });

        // El click que habilita el audio se escucha en window, asi que
        // burbujea igual desde el splash; de paso le devolvemos el foco
        // al canvas para que el teclado siga funcionando.
        splash.addEventListener("click", function () {
            const canvas = document.getElementById("canvas");
            if (canvas) try { canvas.focus(); } catch (e) {}
        });

        traducir();
    })();
    </script>

